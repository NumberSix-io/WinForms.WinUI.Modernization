<UserControl x:Class="PlantOps.WinUI.EquipmentStatusPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Border Margin="20" Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
   <StackPanel Spacing="20">
    <StackPanel Spacing="6">
     <TextBlock x:Name="EquipmentName" Text="Select equipment" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
     <TextBlock x:Name="Identity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
     <Border HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,5">
      <TextBlock x:Name="Status" FontWeight="SemiBold" TextWrapping="Wrap" />
     </Border>
    </StackPanel>
    <StackPanel Spacing="8">
     <Grid><TextBlock Text="Equipment health" /><TextBlock x:Name="HealthText" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
     <ProgressBar x:Name="Health" Maximum="100" AutomationProperties.Name="Equipment health" />
    </StackPanel>
    <StackPanel Spacing="4">
     <TextBlock Text="Next scheduled maintenance" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
     <TextBlock x:Name="NextService" FontSize="20" FontWeight="SemiBold" />
     <TextBlock x:Name="LastService" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
     <StackPanel Spacing="6"><TextBlock Text="Temperature" TextWrapping="Wrap" /><TextBlock x:Name="Temperature" FontSize="24" TextWrapping="Wrap" /></StackPanel>
     <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Runtime" /><TextBlock x:Name="Runtime" FontSize="24" TextWrapping="Wrap" /></StackPanel>
     <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Active alerts" TextWrapping="Wrap" /><TextBlock x:Name="Alerts" FontSize="24" /></StackPanel>
    </Grid>
    <InfoBar x:Name="Warning" IsOpen="False" IsClosable="False" Severity="Warning" />
    <Button x:Name="ScheduleButton" Content="Schedule maintenance" Style="{ThemeResource AccentButtonStyle}"
            HorizontalAlignment="Stretch" IsEnabled="False" Click="OnScheduleClick" />
   </StackPanel>
  </Border>
 </ScrollViewer>
</UserControl>
