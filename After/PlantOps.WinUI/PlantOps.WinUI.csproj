<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Give compiled library XAML a stable resource map in the unpackaged host. -->
    <XamlResourceMapName>PlantOps.WinUI</XamlResourceMapName>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ProjectReference Include="../PlantOps.Core/PlantOps.Core.csproj" />
  </ItemGroup>
</Project>
